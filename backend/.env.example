# Copier ce fichier en .env et remplir les valeurs réelles. .env n'est jamais versionné.

# Secret utilisé pour signer les JWT — générer une valeur longue et aléatoire en production
# (ex: openssl rand -hex 64)
JWT_SECRET=changez-moi-en-une-valeur-longue-et-aleatoire

# Durée de validité d'un token, au format accepté par la librairie jsonwebtoken (ex: "1h", "7d")
JWT_EXPIRES_IN=1h

# Coût de hachage bcrypt (nombre de tours). 10-12 est un bon compromis sécurité/performance.
BCRYPT_SALT_ROUNDS=12
