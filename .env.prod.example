# Copier ce fichier en .env.prod SUR LE VPS UNIQUEMENT et remplir les valeurs réelles.
# .env.prod n'est jamais versionné (voir .gitignore) et ne doit jamais quitter le VPS.
# Contrairement au dev (root .env + backend/.env combinés via bind-mount), ce fichier réunit TOUTES les
# variables du backend en prod, car docker-compose.prod.yml ne bind-mount pas backend/.env dans le conteneur.
# Usage : docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

PORT=3000

# Chaîne de connexion complète fournie par MongoDB Atlas (mongodb+srv://...), utilisateur applicatif dédié
# créé en 8.2 — pas le compte admin du cluster.
MONGO_URI=mongodb+srv://<utilisateur>:<mot-de-passe>@<cluster>.mongodb.net/drumtempo?retryWrites=true&w=majority

# Domaine Vercel définitif du frontend (Étape 8.5) — pas les origines locales de dev.
CORS_ORIGIN=https://app.drumtempo.com

# Secret de signature JWT — DISTINCT du secret de dev. Générer avec : openssl rand -hex 64
JWT_SECRET=changez-moi-en-une-valeur-longue-et-aleatoire-distincte-du-dev

JWT_EXPIRES_IN=1h
BCRYPT_SALT_ROUNDS=12
