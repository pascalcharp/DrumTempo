# Copier ce fichier en .env et remplir les valeurs réelles. .env n'est jamais versionné.
# Ce fichier est à la racine (pas dans /backend) car Docker Compose charge automatiquement
# un .env situé à côté de docker-compose.yml pour la substitution ${VAR} dans docker-compose.yml.

# Identifiants de l'utilisateur root MongoDB (créés à l'initialisation du conteneur db,
# utilisés aussi par le backend pour se connecter — voir MONGO_URI dans docker-compose.yml)
MONGO_ROOT_USERNAME=drumtempo_admin
MONGO_ROOT_PASSWORD=changez-moi-en-une-valeur-longue-et-aleatoire
